<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.agent-session-bookmark</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ASB_APP__/Contents/MacOS/AgentSessionBookmark</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__ASB_LOG_DIR__/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>__ASB_LOG_DIR__/launchd.err</string>
</dict>
</plist>
